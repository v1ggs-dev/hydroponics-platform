# ==========================================
# Hydroponics Platform — Environment Configuration
# ==========================================

# ------------------------------------------
# Environment & Node Settings
# ------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DATABASE_URL=postgresql://hydro_user:hydro_pass@localhost:5432/hydroponics_db?schema=public
POSTGRES_USER=hydro_user
POSTGRES_PASSWORD=hydro_pass
POSTGRES_DB=hydroponics_db
POSTGRES_PORT=5432

# ------------------------------------------
# MQTT Broker (Mosquitto)
# ------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=hydroponics-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------
# Authentication (JWT)
# ------------------------------------------
JWT_SECRET=PRtnZKJQbZxn4DYNXPK2o9LQ4TulaVhX5nBPT04rD3d57hVtFEm9wYf7nGBXnCx4QLBC9nFX50Yo2fmJEmEWQf
JWT_EXPIRATION=7d

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

